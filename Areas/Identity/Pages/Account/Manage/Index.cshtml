@page
@model IndexModel

@{
    ViewData["Title"] = "Manage your account";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<partial name="_StatusMessage" for="StatusMessage" />

<section class="app-shell w-100" aria-labelledby="manage-account-title">
    <header class="app-header text-center">
        <h3 id="manage-account-title" class="app-title mb-0">
            @ViewData["Title"]
        </h3>
        <p class="app-label">
            Use this page to manage your account information.
        </p>
    </header>
    <article class="app-card card border-0 mx-auto mt-4">
        <div class="card-body app-card-body">
            <form id="profile-form" method="post" class="app-form">
                <div asp-validation-summary="ModelOnly" class="app-summary text-danger" role="alert"></div>
                
                <div class="auth-field mb-4">
                    <label asp-for="Username" class="form-label app-label"></label>
                    <input asp-for="Username" class="form-control app-control" placeholder="Please choose your username." disabled />
                </div>
                
                <div class="auth-field mb-4">
                    <label asp-for="Input.PhoneNumber" class="form-label app-label"></label>
                    <input asp-for="Input.PhoneNumber" class="form-control app-control" placeholder="Please enter your phone number."/>
                    <span asp-validation-for="Input.PhoneNumber" class="app-feedback text-danger"></span>
                </div>
                
                <button id="update-profile-button" type="submit" class="btn btn-primary app-submit w-100">
                    Save
                </button>
            </form>
        </div>
    </article>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
