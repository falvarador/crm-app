@page
@model ForgotPasswordModel

@{
    ViewData["Title"] = "Forgot your password?";
}

<main class="auth-main flex-grow-1 d-flex align-items-center justify-content-center px-3 px-sm-4 py-5">
    <section class="auth-shell w-100" aria-labelledby="forgot-password-title">
        <header class="auth-header text-center">
            <div class="auth-brand mx-auto mb-3 mb-md-2" aria-hidden="true">
                <span class="auth-brand-mark">
                    <i class="bi bi-person-square"></i>
                </span>
            </div>

            <h1 id="forgot-password-title" class="auth-title mb-0">Reset your password</h1>
        </header>
        
        <article class="auth-card card border-0 mx-auto mt-4 mt-md-3">
            <div class="card-body auth-card-body">
                <form method="post" class="auth-form" novalidate>
                    <div asp-validation-summary="ModelOnly" class="auth-summary text-danger" role="alert"></div>
                    
                    <div class="auth-field mb-4">
                        <label asp-for="Input.Email" class="form-label app-label"></label>
                        <input asp-for="Input.Email"
                               type="email"
                               class="form-control auth-control"
                               autocomplete="email"
                               placeholder="name@company.com" />
                        <span asp-validation-for="Input.Email" class="auth-feedback text-danger"></span>
                    </div>
                    
                    <button class="btn btn-primary auth-submit w-100" type="submit">
                        Reset Password
                    </button>
                    
                    <hr class="auth-divider" />

                    <nav class="auth-links text-center" aria-label="Account recovery and registration links">
                        <p class="mb-0">
                            <a asp-page="./Login" class="auth-link">Return to login</a>
                        </p>
                    </nav>
                </form>
            </div>
        </article>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
