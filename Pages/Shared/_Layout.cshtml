    <footer class="app-footer border-top mt-auto py-4 py-md-5">
        <div class="container text-center">
            <p class="app-footer-copy mb-3">
                © @DateTime.Today.Year CRM. All rights reserved.
                <a asp-area="" asp-page="/Privacy">Privacy</a>
            </p>
        </div>  
